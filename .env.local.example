# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube a git (ya está en .gitignore).

# Supabase (Project Settings > API en tu proyecto de supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://hmhwbgrtmiqeapeggcjm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el servidor (webhook de pagos). NUNCA la expongas en el
# navegador ni la pegues en un chat: se salta todos los permisos.
SUPABASE_SERVICE_ROLE_KEY=

# Recurrente (dashboard.recurrente.com > Developers / API)
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
